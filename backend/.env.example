# Copier ce fichier vers .env (ignoré par Git) et renseigner les vraies
# valeurs. Ne jamais committer de secret.
#
# Voir docs/specs/2026-07-31-authentification-microsoft-entra-v1.md et
# docs/plans/2026-07-31-authentification-microsoft-entra-v1.md pour le detail
# du plan d'authentification.
#
# En production/staging sur le VPS, ces variables viennent de
# /etc/gnu-gesta/backend.env (permissions 600, hors Git), chargé par le
# service systemd — voir "Secrets authentification Microsoft Entra" dans
# docs/deployment.md. Ce fichier .env.example ne sert que de modèle local.

# Mode d'authentification : `entra` par défaut. Pour tester manuellement sans
# Microsoft Entra, utiliser `dev` uniquement avec NODE_ENV=development et sur
# localhost ; voir docs/proposals/2026-08-26-authentification-locale-safe.md.
AUTH_MODE=entra

# Adresse d'écoute du backend. En mode AUTH_MODE=dev, seule une adresse
# loopback est acceptée.
HOST=127.0.0.1

# Inscription d'application Microsoft Entra (tenant Haute Ecole Leonard de
# Vinci), monolocataire.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# URI de redirection exacte declaree dans Entra. En local :
# http://localhost:5173/api/auth/callback. En production :
# https://gng.seront.be/api/auth/callback (deja enregistree dans Entra).
ENTRA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Origine publique du frontend, utilisee pour les redirections post-connexion.
# En production : https://gng.seront.be
APP_BASE_URL=http://localhost:5173

# Secret de signature du cookie de session (chaine aleatoire longue, au moins
# 16 caractères ; obligatoire aussi en mode AUTH_MODE=dev).
# Pendant la periode de developpement (pas encore de mise en production
# reelle), la meme valeur que ENTRA_CLIENT_SECRET est reutilisee entre local
# et VPS par decision explicite — voir docs/production-readiness.md.
SESSION_SECRET=

# Seule adresse reconnue comme gestionnaire.
GESTA_MANAGER_EMAIL=gregory.seront@vinci.be

PORT=3000
